# Copy to .env and fill in. .env is gitignored and never committed.
CROSSFOOT_LLM_API_KEY=

# Default base URL is the Gemini OpenAI compatible endpoint.
# CROSSFOOT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# CROSSFOOT_LLM_MODEL=gemini-2.5-flash

# Or point at a local Penstock gateway:
# CROSSFOOT_LLM_BASE_URL=http://localhost:8080/v1
