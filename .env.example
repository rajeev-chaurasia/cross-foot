# Copy to .env and fill in. .env is gitignored and never committed.
# Provider keys use each provider's conventional variable name.
# Call priority: gemini, groq, openrouter, mistral.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional: route through a custom OpenAI compatible gateway, e.g. Penstock.
# When set it becomes the first profile in the pool.
# CROSSFOOT_LLM_BASE_URL=http://localhost:8080/v1
# CROSSFOOT_LLM_API_KEY=
# CROSSFOOT_LLM_MODEL=

# Other settings:
# CROSSFOOT_LLM_TIMEOUT_SECONDS=120
# CROSSFOOT_DATA_DIR=data
