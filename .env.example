# Copy to .env and fill in. .env is gitignored and never committed.
# Provider keys use each provider's conventional variable name.
# Call priority: gemini, groq, openrouter, mistral.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Optional: route through a custom OpenAI compatible gateway, e.g. Penstock.
# When set it becomes the first profile in the pool.
# CROSSFOOT_LLM_BASE_URL=http://localhost:8080/v1
# CROSSFOOT_LLM_API_KEY=
# CROSSFOOT_LLM_MODEL=

# The published vision numbers came from a local model reached the same way,
# after free tier quota ran out mid corpus. Run `just model` first: the stock
# qwen2.5vl:7b serves a 4096 token context, which truncates the answer on a
# long statement, and the derived model is the same weights with room to reply.
# CROSSFOOT_LLM_BASE_URL=http://localhost:11434/v1
# CROSSFOOT_LLM_API_KEY=ollama
# CROSSFOOT_LLM_MODEL=qwen2.5vl-crossfoot:7b

# Other settings:
# CROSSFOOT_LLM_TIMEOUT_SECONDS=120
# CROSSFOOT_DATA_DIR=data
