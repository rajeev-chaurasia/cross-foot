              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ledger Amount Cents"
            },
            "ledger_entry_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ledger Entry Id"
            },
            "memo_amount_cents": {
              "default": 0,
              "title": "Memo Amount Cents",
              "type": "integer"
            },
            "resolution": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resolution"
            },
            "resolved_at": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resolved At"
            },
            "run_id": {
              "title": "Run Id",
              "type": "string"
            },
            "statement_amount_cents": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Statement Amount Cents"
            },
            "statement_line_no": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Statement Line No"
            },
            "status": {
              "$ref": "#/components/schemas/ExceptionStatus",
              "default": "open"
            }
          },
          "required": [
            "exception_id",
            "run_id",
            "exception_type",
            "dollar_impact_cents",
            "explanation",
            "detected_at"
          ],
          "title": "ExceptionItem",
          "type": "object"
        },
