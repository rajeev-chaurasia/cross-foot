            },
            "route": {
              "$ref": "#/components/schemas/ExtractionRoute"
            },
            "split": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SplitName"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "doc_id",
            "file_path",
            "doc_type",
            "quality_tier",
            "route",
            "split",
            "error_kind"
          ],
          "title": "DocumentSummary",
          "type": "object"
        },
        "ExceptionItem": {
          "description": "The frozen exception record plus the two columns resolving one writes.",
          "properties": {
            "detected_at": {
              "format": "date-time",
              "title": "Detected At",
              "type": "string"
            },
            "doc_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Doc Id"
            },
            "dollar_impact_cents": {
              "title": "Dollar Impact Cents",
              "type": "integer"
            },
