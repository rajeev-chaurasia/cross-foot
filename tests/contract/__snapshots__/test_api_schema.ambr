        },
        "FieldSignals": {
          "description": "Raw evidence feeding the confidence model. None means signal unavailable.\n\nEvery member is computed from the artifact and the extraction alone. Nothing\nhere may come from the dataset manifest: a confidence score is a claim about\nwhat the pipeline can tell without an answer key, so a feature only the\ngenerator could supply inflates that claim by exactly what the generator knew.",
          "properties": {
            "char_ambiguity": {
              "default": 0.0,
              "title": "Char Ambiguity",
              "type": "number"
            },
            "crossfoot_ok": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Crossfoot Ok"
            },
            "crossfoot_residual_suspect": {
              "default": false,
              "title": "Crossfoot Residual Suspect",
              "type": "boolean"
            },
            "det_llm_agreement": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Det Llm Agreement"
            },
            "grammar_match": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Grammar Match"
            },
            "route": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ExtractionRoute"
                },
                {
                  "type": "null"
                }
              ]
            },
            "self_consistency": {
