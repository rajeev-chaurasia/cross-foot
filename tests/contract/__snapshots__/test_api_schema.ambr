        "CropKind": {
          "enum": [
            "exact_bbox",
            "row_band",
            "full_page"
          ],
          "title": "CropKind",
          "type": "string"
        },
        "CropUnavailable": {
          "description": "The typed answer when a crop cannot be rendered, so the queue shows the value alone.\n\nA corrupted scan is a fact about the document, not a server fault, and the\nreviewer still has to be able to work the field, so it is this rather than a\n500 or a bare broken image.",
          "properties": {
            "detail": {
              "title": "Detail",
              "type": "string"
            },
            "doc_id": {
              "title": "Doc Id",
              "type": "string"
            },
            "field_id": {
              "title": "Field Id",
              "type": "string"
            },
            "reason": {
              "$ref": "#/components/schemas/CropUnavailableReason"
            }
          },
          "required": [
            "doc_id",
            "field_id",
            "reason",
            "detail"
          ],
          "title": "CropUnavailable",
          "type": "object"
        },
        "CropUnavailableReason": {
          "description": "Why a field that exists still has no pixels beside it.",
          "enum": [
            "source_missing",
            "source_unreadable",
            "source_unreachable",
            "page_missing",
            "no_page_image"
          ],
          "title": "CropUnavailableReason",
          "type": "string"
        },
        "DocType": {
          "enum": [
            "parts_statement",
            "warranty_credit_memo",
            "floorplan_statement",
            "incentive_statement"
          ],
          "title": "DocType",
          "type": "string"
        },
        "DocumentSummary": {
          "description": "The document a field was read from.",
          "properties": {
            "doc_id": {
              "title": "Doc Id",
              "type": "string"
            },
            "doc_type": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/DocType"
                },
