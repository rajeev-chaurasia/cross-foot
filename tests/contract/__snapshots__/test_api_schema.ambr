# serializer version: 1
# name: test_openapi_schema_is_the_frozen_frontend_contract
  '''
  {
    "components": {
      "schemas": {
        "CalibrationBin": {
          "properties": {
            "count": {
              "title": "Count",
              "type": "integer"
            },
            "empirical_accuracy": {
              "title": "Empirical Accuracy",
              "type": "number"
            },
            "field_family": {
              "$ref": "#/components/schemas/FieldFamily"
            },
            "mean_confidence": {
              "title": "Mean Confidence",
              "type": "number"
            }
          },
          "required": [
            "field_family",
            "mean_confidence",
            "empirical_accuracy",
            "count"
          ],
          "title": "CalibrationBin",
          "type": "object"
        },
        "CorrectedItem": {
          "description": "The updated item plus what the reviewer's value did to the document's exceptions.\n\nNull when the document cannot be reconciled: no ledger under the dataset\ndirectory, or no blocking identity to match against. A reconciled document\nreports the change even when it is three zeroes, because \"nothing moved\" and\n\"nothing could be checked\" are different answers.",
          "properties": {
            "confidence": {
              "title": "Confidence",
              "type": "number"
            },
            "crop_url": {
              "title": "Crop Url",
              "type": "string"
            },
            "doc_id": {
              "title": "Doc Id",
              "type": "string"
            },
            "family": {
              "$ref": "#/components/schemas/FieldFamily"
            },
            "field_id": {
              "title": "Field Id",
              "type": "string"
            },
            "line_no": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Line No"
            },
            "name": {
              "$ref": "#/components/schemas/FieldName"
            },
            "raw_text": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Raw Text"
            },
            "reconciliation": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ReconciliationDelta"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "#/components/schemas/ReviewStatus"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value"
            }
          },
          "required": [
            "field_id",
            "doc_id",
            "line_no",
            "name",
            "family",
            "raw_text",
            "value",
            "confidence",
            "status",
            "crop_url",
            "reconciliation"
          ],
          "title": "CorrectedItem",
          "type": "object"
        },
        "CorrectionRequest": {
          "description": "A reviewer's replacement value, validated against the field's family.",
          "properties": {
            "reviewer": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Reviewer",
              "type": "string"
            },
            "value": {
              "maxLength": 256,
              "title": "Value",
              "type": "string"
            }
          },
          "required": [
            "value",
            "reviewer"
          ],
          "title": "CorrectionRequest",
          "type": "object"
        },
        "CostCell": {
          "properties": {
            "calls": {
              "title": "Calls",
              "type": "integer"
            },
            "completion_tokens": {
              "title": "Completion Tokens",
              "type": "integer"
            },
