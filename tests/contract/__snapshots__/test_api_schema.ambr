        "ReconciliationDelta": {
          "description": "What re-reconciling one document did to the exceptions it owns.\n\n`dollars_at_risk_change_cents` is the change in the sum of absolute impact of\nthe document's open exceptions, so a correction that clears risk reports a\nnegative number.",
          "properties": {
            "dollars_at_risk_change_cents": {
              "title": "Dollars At Risk Change Cents",
              "type": "integer"
            },
            "exceptions_added": {
