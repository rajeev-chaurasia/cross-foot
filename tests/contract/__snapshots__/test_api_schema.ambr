            },
            "signals": {
              "$ref": "#/components/schemas/FieldSignals"
            },
            "status": {
              "$ref": "#/components/schemas/ReviewStatus"
            },
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value"
            }
          },
          "required": [
            "field_id",
            "doc_id",
            "line_no",
            "name",
            "family",
            "raw_text",
            "value",
            "confidence",
            "status",
            "crop_url",
            "crop_kind",
            "crop_unavailable_reason",
            "signals",
            "document",
            "neighbors"
          ],
          "title": "ReviewItemDetail",
          "type": "object"
        },
        "ReviewStatus": {
          "enum": [
            "auto_accepted",
            "needs_review",
            "human_accepted",
            "human_corrected"
          ],
          "title": "ReviewStatus",
          "type": "string"
        },
        "Scorecard": {
          "properties": {
            "calibration": {
              "default": [],
              "items": {
                "$ref": "#/components/schemas/CalibrationBin"
              },
              "title": "Calibration",
              "type": "array"
            },
            "costs": {
              "default": [],
              "items": {
                "$ref": "#/components/schemas/CostCell"
              },
              "title": "Costs",
              "type": "array"
            },
            "created_at": {
              "format": "date-time",
              "title": "Created At",
              "type": "string"
            },
            "dataset_config_hash": {
              "title": "Dataset Config Hash",
              "type": "string"
            },
            "documents_processed": {
              "title": "Documents Processed",
              "type": "integer"
            },
            "documents_total": {
              "title": "Documents Total",
              "type": "integer"
            },
            "documents_unprocessable": {
              "title": "Documents Unprocessable",
              "type": "integer"
            },
            "field_accuracy": {
              "items": {
                "$ref": "#/components/schemas/FieldAccuracyCell"
              },
              "title": "Field Accuracy",
              "type": "array"
            },
            "git_sha": {
              "title": "Git Sha",
              "type": "string"
            },
            "master_seed": {
              "title": "Master Seed",
              "type": "integer"
            },
            "models_used": {
              "items": {
                "type": "string"
              },
              "title": "Models Used",
              "type": "array"
            },
            "notes": {
              "default": "",
              "title": "Notes",
              "type": "string"
            },
            "platt_scaling": {
              "default": [],
              "items": {
                "$ref": "#/components/schemas/PlattCell"
              },
              "title": "Platt Scaling",
              "type": "array"
            },
            "reconciliation": {
              "default": [],
              "items": {
                "$ref": "#/components/schemas/ReconCell"
              },
              "title": "Reconciliation",
              "type": "array"
            },
            "run_id": {
              "title": "Run Id",
              "type": "string"
            },
            "split": {
              "$ref": "#/components/schemas/SplitName"
            },
            "threshold_sweep": {
              "default": [],
              "items": {
                "$ref": "#/components/schemas/ThresholdPoint"
              },
              "title": "Threshold Sweep",
              "type": "array"
            }
          },
          "required": [
            "run_id",
            "created_at",
            "git_sha",
            "dataset_config_hash",
            "master_seed",
            "split",
            "models_used",
            "documents_total",
            "documents_processed",
            "documents_unprocessable",
            "field_accuracy"
          ],
          "title": "Scorecard",
          "type": "object"
        },
        "SplitName": {
          "enum": [
            "train",
            "calibration",
            "test"
          ],
          "title": "SplitName",
          "type": "string"
        },
        "Summary": {
          "description": "The tile above the queue. Every number is counted in SQL, never in the UI.\n\nEvery count here is over the whole database, every split included, and it is\na reading taken now rather than a result. `review_queue_share` in particular\nfalls each time a reviewer accepts a field, which is exactly what makes it a\ndifferent quantity from the review rate a scorecard publishes: that one is\nmeasured on the held out split at a fixed threshold and does not move. The\ntwo are never to be printed as though they were the same figure.",
          "properties": {
            "auto_accept_rate": {
              "title": "Auto Accept Rate",
              "type": "number"
            },
            "cost_per_document_microusd": {
              "title": "Cost Per Document Microusd",
              "type": "integer"
            },
            "documents_processed": {
              "title": "Documents Processed",
              "type": "integer"
            },
            "fields_extracted": {
              "title": "Fields Extracted",
              "type": "integer"
            },
            "gross_dollars_at_risk_cents": {
              "title": "Gross Dollars At Risk Cents",
              "type": "integer"
            },
            "open_exception_count": {
              "title": "Open Exception Count",
              "type": "integer"
            },
            "review_queue_depth": {
              "title": "Review Queue Depth",
              "type": "integer"
            },
            "review_queue_share": {
              "title": "Review Queue Share",
              "type": "number"
            }
          },
          "required": [
            "documents_processed",
            "fields_extracted",
            "auto_accept_rate",
            "review_queue_depth",
            "review_queue_share",
            "open_exception_count",
            "gross_dollars_at_risk_cents",
            "cost_per_document_microusd"
          ],
          "title": "Summary",
          "type": "object"
        },
        "ThresholdPoint": {
          "properties": {
            "auto_accept_precision": {
              "title": "Auto Accept Precision",
              "type": "number"
            },
            "field_family": {
              "$ref": "#/components/schemas/FieldFamily"
            },
            "review_rate": {
              "title": "Review Rate",
              "type": "number"
            },
            "threshold": {
              "title": "Threshold",
              "type": "number"
            }
          },
          "required": [
            "field_family",
            "threshold",
            "auto_accept_precision",
            "review_rate"
          ],
          "title": "ThresholdPoint",
          "type": "object"
        },
        "ValidationError": {
          "properties": {
            "ctx": {
              "title": "Context",
              "type": "object"
            },
            "input": {
              "title": "Input"
            },
            "loc": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              },
              "title": "Location",
              "type": "array"
            },
            "msg": {
              "title": "Message",
              "type": "string"
            },
            "type": {
              "title": "Error Type",
              "type": "string"
            }
          },
          "required": [
            "loc",
            "msg",
            "type"
          ],
          "title": "ValidationError",
          "type": "object"
        }
      }
    },
    "info": {
      "description": "The review queue, the exceptions dashboard, and the published calibration figures.",
      "title": "Crossfoot review API",
      "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/api/crops/{doc_id}/{field_id}.png": {
        "get": {
          "description": "The crop for one field, rendered on the first request and cached after it.\n\nA segment that leaves the crop root is a 400 and never a file read.",
          "operationId": "crop_api_crops__doc_id___field_id__png_get",
          "parameters": [
            {
              "in": "path",
              "name": "doc_id",
              "required": true,
              "schema": {
                "title": "Doc Id",
                "type": "string"
              }
            },
            {
              "in": "path",
              "name": "field_id",
              "required": true,
              "schema": {
                "title": "Field Id",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "image/png": {}
              },
              "description": "The crop."
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            },
            "424": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/CropUnavailable"
                  }
                }
              },
              "description": "The field exists but its source document cannot be rendered."
            }
          },
          "summary": "Crop",
          "tags": [
            "crops"
          ]
        }
      },
      "/api/documents": {
        "get": {
          "description": "Every ingested document matching the filter, in doc_id order.",
          "operationId": "list_documents_api_documents_get",
          "parameters": [
            {
              "description": "How the file was routed.",
              "in": "query",
              "name": "route",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ExtractionRoute"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "How the file was routed.",
                "title": "Route"
              }
            },
            {
              "description": "train, calibration, or test.",
              "in": "query",
              "name": "split",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/SplitName"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "train, calibration, or test.",
                "title": "Split"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Page_DocumentSummary_"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "List Documents",
          "tags": [
            "documents"
          ]
        }
      },
      "/api/documents/{doc_id}": {
        "get": {
          "description": "One document, including the error kind when nothing could be extracted from it.",
          "operationId": "get_document_api_documents__doc_id__get",
          "parameters": [
            {
              "description": "Document identifier from the dataset manifest.",
              "in": "path",
              "name": "doc_id",
              "required": true,
              "schema": {
                "description": "Document identifier from the dataset manifest.",
                "title": "Doc Id",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Get Document",
          "tags": [
            "documents"
          ]
        }
      },
      "/api/exceptions": {
        "get": {
          "description": "One page of exceptions ranked by absolute dollar impact, largest first.",
          "operationId": "list_exceptions_api_exceptions_get",
          "parameters": [
            {
              "description": "One of the six exception types.",
              "in": "query",
              "name": "type",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ExceptionType"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "One of the six exception types.",
                "title": "Type"
              }
            },
            {
              "description": "Open state.",
              "in": "query",
              "name": "status",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ExceptionStatus"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Open state.",
                "title": "Status"
              }
            },
            {
              "description": "Floor on absolute dollar impact, the same value the rank uses.",
              "in": "query",
              "name": "min_impact_cents",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Floor on absolute dollar impact, the same value the rank uses.",
                "title": "Min Impact Cents"
              }
            },
            {
              "description": "Ranking, always total.",
              "in": "query",
              "name": "sort",
              "required": false,
              "schema": {
                "$ref": "#/components/schemas/ExceptionSort",
                "default": "impact",
                "description": "Ranking, always total."
              }
            },
            {
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "default": 50,
                "maximum": 500,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "offset",
              "required": false,
              "schema": {
                "default": 0,
                "maximum": 1000000000,
                "minimum": 0,
                "title": "Offset",
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Page_ExceptionItem_"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "List Exceptions",
          "tags": [
            "exceptions"
          ]
        }
      },
      "/api/exceptions/{exception_id}/resolve": {
        "post": {
          "description": "Close an exception, recording what was done about it. The dollars stay as detected.",
          "operationId": "resolve_exception_api_exceptions__exception_id__resolve_post",
          "parameters": [
            {
              "description": "Exception being worked.",
              "in": "path",
              "name": "exception_id",
              "required": true,
              "schema": {
                "description": "Exception being worked.",
                "title": "Exception Id",
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolutionRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ExceptionItem"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Resolve Exception",
          "tags": [
            "exceptions"
          ]
        }
      },
      "/api/metrics": {
        "get": {
          "description": "The latest committed scorecard with its calibration points and threshold sweep.",
          "operationId": "metrics_api_metrics_get",
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/MetricsPayload"
                  }
                }
              },
              "description": "Successful Response"
            }
          },
          "summary": "Metrics",
          "tags": [
            "metrics"
          ]
        }
      },
      "/api/review/items/{field_id}": {
        "get": {
          "description": "One field with its signal breakdown, its document, and the rest of its line.",
          "operationId": "review_item_api_review_items__field_id__get",
          "parameters": [
            {
              "description": "Field the reviewer is looking at.",
              "in": "path",
              "name": "field_id",
              "required": true,
              "schema": {
                "description": "Field the reviewer is looking at.",
                "title": "Field Id",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ReviewItemDetail"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Review Item",
          "tags": [
            "review"
          ]
        }
      },
      "/api/review/items/{field_id}/accept": {
        "post": {
          "description": "Keep the extracted value and mark it reviewed.",
          "operationId": "accept_item_api_review_items__field_id__accept_post",
          "parameters": [
            {
              "description": "Field the reviewer is looking at.",
              "in": "path",
              "name": "field_id",
              "required": true,
              "schema": {
                "description": "Field the reviewer is looking at.",
                "title": "Field Id",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ReviewItem"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Accept Item",
          "tags": [
            "review"
          ]
        }
      },
      "/api/review/items/{field_id}/correct": {
        "post": {
          "description": "Replace a value with the reviewer's reading, then re-reconcile its document.\n\nThe loop closes here: the exceptions on the dashboard are re-derived from\nwhat the human just decided rather than from the reading they overruled.",
          "operationId": "correct_item_api_review_items__field_id__correct_post",
          "parameters": [
            {
              "description": "Field the reviewer is looking at.",
              "in": "path",
              "name": "field_id",
              "required": true,
              "schema": {
                "description": "Field the reviewer is looking at.",
                "title": "Field Id",
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/CorrectedItem"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Correct Item",
          "tags": [
            "review"
          ]
        }
      },
      "/api/review/queue": {
        "get": {
          "description": "Fields ranked least trusted first, with the count the filter matched.",
          "operationId": "review_queue_api_review_queue_get",
          "parameters": [
            {
              "description": "Unset means every field, not only the queue.",
              "in": "query",
              "name": "status",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ReviewStatus"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Unset means every field, not only the queue.",
                "title": "Status"
              }
            },
            {
              "description": "Field family.",
              "in": "query",
              "name": "family",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/FieldFamily"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Field family.",
                "title": "Family"
              }
            },
            {
              "description": "Quality tier of the document.",
              "in": "query",
              "name": "tier",
              "required": false,
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/QualityTier"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Quality tier of the document.",
                "title": "Tier"
              }
            },
            {
              "description": "Queue order, always total.",
              "in": "query",
              "name": "sort",
              "required": false,
              "schema": {
                "$ref": "#/components/schemas/QueueSort",
                "default": "confidence",
                "description": "Queue order, always total."
              }
            },
            {
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "default": 50,
                "maximum": 500,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "offset",
              "required": false,
              "schema": {
                "default": 0,
                "maximum": 1000000000,
                "minimum": 0,
                "title": "Offset",
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Page_ReviewItem_"
                  }
                }
              },
              "description": "Successful Response"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/HTTPValidationError"
                  }
                }
              },
              "description": "Validation Error"
            }
          },
          "summary": "Review Queue",
          "tags": [
            "review"
          ]
        }
      },
      "/api/stats/summary": {
        "get": {
          "description": "Counts, rates, and money, all of them counted in SQL.",
          "operationId": "stats_summary_api_stats_summary_get",
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Summary"
                  }
                }
              },
              "description": "Successful Response"
            }
          },
          "summary": "Stats Summary",
          "tags": [
            "metrics"
          ]
        }
      }
    }
  }
  '''
# ---
